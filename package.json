    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.47",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.2.2",
